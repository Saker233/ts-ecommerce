generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}
enum Role {
  ADMIN
  USER
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  role Role @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Product {
  id Int @id @default(autoincrement())
  name String
  description String
  price Decimal
  tags String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}